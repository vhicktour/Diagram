# NVIDIA NIM API key — free from https://build.nvidia.com/settings/api-keys (starts with "nvapi-").
# Server-side only: copy this file to .env.local and fill it in. Never prefix with NEXT_PUBLIC_.
NVIDIA_API_KEY=

# Optional. Defaults to the hosted NVIDIA endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional. Model used by the assistant (needs tool calling).
# Default: meta/llama-3.1-70b-instruct (strong tool use, text only).
# For image/sketch upload use a vision model, e.g. meta/llama-3.2-90b-vision-instruct
# or meta/llama-3.2-11b-vision-instruct (weaker reasoning). z-ai/glm-5.2 also works.
NVIDIA_AI_MODEL=
